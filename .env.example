# =============================================================================
# FRONTEND (Next.js) — used by the Next.js dev server and Vercel deployment
# =============================================================================

# Required: Postgres connection string (Neon in prod, local Docker in dev)
POSTGRES_URL="postgresql://postgres:password@localhost:5432/gitdiagram"

# Required: OpenAI key for the 3-stage generation pipeline
OPENAI_API_KEY=
# Optional: model used for all three generation stages (default: gpt-5.2)
OPENAI_MODEL=gpt-5.2

# Set to true to route generation calls to the FastAPI backend instead of Next.js route handlers
NEXT_PUBLIC_USE_LEGACY_BACKEND=false
# Base URL of the FastAPI backend (no trailing slash). Only used when USE_LEGACY_BACKEND=true.
# e.g. https://gitdiagram-api-production-xxxx.up.railway.app or http://localhost:8000
NEXT_PUBLIC_API_DEV_URL=

# =============================================================================
# ADMIN — protects the /admin settings panel
# =============================================================================

# Required in production. Shared secret for accessing /admin.
# In development, /admin is accessible without this.
ADMIN_SECRET=

# =============================================================================
# BACKEND (FastAPI) — only used when running the Python backend (docker-compose / pnpm dev:backend)
# =============================================================================

# Optional: server-side GitHub PAT for higher API rate limits (60/hr → 5 000/hr).
# Note: the Next.js frontend does NOT read this; it relies on the user-supplied PAT from localStorage.
GITHUB_PAT=
# Optional: GitHub App auth (fallback when GITHUB_PAT is not provided)
GITHUB_CLIENT_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# Optional: api-analytics.com key for backend request analytics
API_ANALYTICS_KEY=

# Optional: comma-separated CORS origins for the FastAPI backend
CORS_ORIGINS="http://localhost:3000,https://gitdiagram.com,https://www.gitdiagram.com"

# Optional: runtime flags for uvicorn (see backend/entrypoint.sh)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=2
